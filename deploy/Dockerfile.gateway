# Gateway image. Deliberately minimal: this container exists to hold a
# credential and forward requests, so it carries nothing else.
FROM python:3.12-slim

# A fixed uid/gid so a bind-mounted secret can be chowned to a known owner, and
# so the non-root user is not merely "whatever the next build produces".
RUN groupadd --gid 1001 safety-gateway \
 && useradd --uid 1001 --gid 1001 --no-create-home --shell /usr/sbin/nologin safety-gateway

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

# The trace database is written by the gateway user; the volume is created by
# compose so its ownership follows the same uid.
RUN mkdir -p /var/lib/safety && chown 1001:1001 /var/lib/safety

USER 1001:1001
EXPOSE 8080

# Binds loopback inside the container by default. Compose publishes it to the
# host explicitly; nothing here listens on a public interface on its own.
ENTRYPOINT ["safety"]
CMD ["gateway", "--help"]