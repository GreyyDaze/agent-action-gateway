# Tier 1 deployment: the gateway as its own OS user on one host.
#
# This is the minimum that makes the custody claim true. The boundary is the
# kernel's, not ours:
#
#   * User=agent-action-gateway  -> the agent's own user cannot read the gateway's
#     environment through /proc/<pid>/environ, and cannot ptrace it.
#   * LoadCredential=       -> the secret arrives as a read-only file in
#     /run/credentials/agent-action-gateway.service/. It is never in the
#     environment, so it cannot appear in `ps`, a crash dump or a log line.
#
# Install:
#   sudo pip install 'agent-action-gateway[yaml]'   # the YAML route file needs PyYAML
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin agent-action-gateway
#   sudo install -m 0644 <(curl -fsSL $BASE/deploy/routes.example.yaml) /etc/agent-action-gateway/routes.yaml
#   then set each route's secret_env to the credential path below
#
# Not tested on a Linux host yet. The gateway refuses a secret file that is
# group- or world-readable or not owned by its own user, so check that the
# credential file systemd provides passes that check on your system.
#   sudo systemctl edit agent-action-gateway     # set Environment=AGENT_GATEWAY_MASTER_KEY=...
#   sudo systemctl enable --now agent-action-gateway
#
# Verify it, do not assume it:
#   make verify-boundary

[Unit]
Description=Agent Action Gateway gateway (holds upstream credentials)
Documentation=file:///etc/agent-action-gateway/routes.yaml
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=agent-action-gateway
Group=agent-action-gateway
ExecStart=/usr/local/bin/agent-gateway gateway \
    --config /etc/agent-action-gateway/routes.yaml \
    --db /var/lib/agent-action-gateway/gateway.db

# The master key issues and revokes virtual keys. It is the one secret that
# belongs in the environment; every upstream credential arrives via
# LoadCredential instead.
EnvironmentFile=-/etc/agent-action-gateway/gateway.env

# Upstream API credentials, one per route that needs one. Each is mounted
# read-only in /run/credentials/agent-action-gateway.service/<name>. A route reads one with
#   secret_env: "file:/run/credentials/agent-action-gateway.service/github_token"
LoadCredential=github_token:/etc/agent-action-gateway/credentials/github_token

StateDirectory=agent-action-gateway
WorkingDirectory=/var/lib/agent-action-gateway

# The gateway needs a network to reach providers and a filesystem for its
# database. It does not need to read the route config as anything other than
# the administrator wrote it, nor to write anywhere except its own state.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Do not let the credential reach a log line.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target